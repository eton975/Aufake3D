index 0000000000000000000000000000000000000000..882346168095715a4f3ae52276f87cb869f6fcb1
--- /dev/null
+++ b/Source/Engine/win32/test_vortex56_native.c
@@ -0,0 +1,57 @@
+/* Hardware-reference format/DSP integration tests; no game or sound device. */
+#include <stdio.h>
+#include <stdlib.h>
+#include "stream_core.h"
+static A3DMix m;
+static A3DMixVoice v;
+static unsigned char data[4096];
+static unsigned char out[1024];
+static int fail(const char *p){fprintf(stderr,"FAIL %s\n",p);return 1;}
+static int closef(float a,float b,float tol){return aufake_v2_abs(a-b)<=tol;}
+static unsigned long long signal_energy(void){
+ unsigned long long e=0;
+ for(unsigned i=0;i<512u;i++){
+  int n=out[i*2] | ((int)out[i*2+1]<<8);
+  if(n>32767)n-=65536;
+  e+=(unsigned long long)(n*n);
+ }
+ return e;
+}
+static void prepare(unsigned mode){
+ a3dmix_init(&m);a3dmix_voice_init(&v);
+ m.hrtf_mode=mode;m.master_boost=1.0f;m.reverb_wet=0.0f;m.hrtf_taps=56u;
+ v.pcm=data;v.bytes=sizeof(data);v.rate=48000u;v.channels=1u;v.bits=16u;
+ v.active=1u;v.looping=1u;v.pos[2]=-1.0f;
+ a3dmix_add(&m,&v);
+}
+int main(void){
+ float c[2][56],d[2];
+ aufake_v2_lookup(0.0f,0.0f,c,d);
+ if(!closef(c[0][0],(float)aufake_v2_coeff[3*24][0][0],0.0001f))return fail("front tap0");
+ if(!closef(d[0],0.0f,0.00001f)||!closef(d[1],0.0f,0.00001f))return fail("front zero ITD");
+ aufake_v2_lookup(180.0f,0.0f,c,d);
+ if(!closef(d[0],0.0f,0.00001f)||!closef(d[1],0.0f,0.00001f))return fail("corrected rear ITD");
+ if(!closef(c[0][0],5945.0f,0.0001f)||!closef(c[1][0],5792.0f,0.0001f))return fail("corrected rear coeff");
+ aufake_v2_lookup(90.0f,0.0f,c,d);
+ if(d[0]<30.0f||d[1]!=0.0f)return fail("right azimuth must delay left ear");
+ aufake_v2_lookup(270.0f,0.0f,c,d);
+ if(d[1]<30.0f||d[0]!=0.0f)return fail("left azimuth must delay right ear");
+ aufake_v2_lookup(355.0f,0.0f,c,d);
+ if(!closef(c[0][0],((float)aufake_v2_coeff[3*24+23][0][0]*5.0f+(float)aufake_v2_coeff[3*24][0][0]*10.0f)/15.0f,1.0f))return fail("azimuth wrap");
+ for(unsigned i=0;i<sizeof(data);i++)data[i]=0;
+ data[0]=0xff;data[1]=0x7f;
+ prepare(1u);a3dmix_render(&m,out,256u);
+ if(signal_energy()<50000u)return fail("fast56 impulse silent");
+ float fast=v.v2_coeff[0][0];
+ prepare(2u);a3dmix_render(&m,out,256u);
+ if(signal_energy()<50000u)return fail("reference56 impulse silent");
+ if(v.v2_coeff[0][0]!=fast)return fail("static position modes differ");
+ /* After direction change, reference glides rather than jumps immediately. */
+ float before=v.v2_coeff[0][0];v.pos[0]=2.0f;
+ a3dmix_render(&m,out,256u);
+ float target=v.v2_target[0][0];
+ if(closef(target,before,1.0f))return fail("movement did not change target");
+ if(!(aufake_v2_abs(v.v2_coeff[0][0]-before)<aufake_v2_abs(target-before)))return fail("tracking jumped too far");
+ printf("PASS: corrected HRTF 56 taps, channel ITD, wrap, impulse render, reference tracking\n");
+ return 0;
+}
diff --git a/Source/Engine/win32/vortex2_hrtf.h b/Source/Engine/win32/vortex2_hrtf.h
new file mode 100644
index 0000000000000000000000000000000000000000..63f9c4211415b44d1a93870a000ace7fcce5582d
--- /dev/null
+++ b/Source/Engine/win32/vortex2_hrtf.h
@@ -0,0 +1,87 @@
+/* Aufake3D 0.9.0: AU8830-derived 56-tap binaural reference path.
+ * Table provenance: user-supplied corrected register trace, see data/.
+ *
+ * FAST computes a bilinear 56-tap target once per 256-frame voice block,
+ * then performs exactly 112 FIR MACs per sample plus two fractional delays.
+ * REFERENCE uses the same FIR with the measured 64-sample coefficient and
+ * ITD glides. Neither mode claims bit-exact AU8830 integer DSP arithmetic.
+ * No heap, I/O, CRT math calls, trigonometry or interpolation in the
+ * sample-inner convolution loop. The rendering worker owns voice state.
+ */
+#ifndef AUFAKE_VORTEX2_HRTF_H
+#define AUFAKE_VORTEX2_HRTF_H
+#include "vortex2_hrtf_table.h"
+#define AUFAKE_V2_DELAY_SIZE 64u
+#define AUFAKE_V2_PI 3.14159265358979323846f
+#define AUFAKE_V2_RAD2DEG (180.0f/AUFAKE_V2_PI)
+
+static float aufake_v2_abs(float x){return x<0.0f?-x:x;}
+/* Fast atan2 approximation max error roughly 0.01 degrees; NOT a hardware
+ * angle quantizer. Hardware-exact conversion is a future validation item. */
+static float aufake_v2_atan2(float y,float x){
+ const float quarter=0.7853981633974483f,threequarter=2.356194490192345f;
+ float ay=aufake_v2_abs(y)+1.0e-12f,r,a;
+ if(x>=0.0f){r=(x-ay)/(x+ay);a=quarter+(0.1963f*r*r-0.9817f)*r;}
+ else {r=(x+ay)/(ay-x);a=threequarter+(0.1963f*r*r-0.9817f)*r;}
+ return y<0.0f?-a:a;
+}
+static void aufake_v2_orientation(const float src[3],const float lis[3],
+ const float fwd[3],const float up[3],unsigned long coords,float *az,float *el){
+ float rx=fwd[1]*up[2]-fwd[2]*up[1];
+ float ry=fwd[2]*up[0]-fwd[0]*up[2];
+ float rz=fwd[0]*up[1]-fwd[1]*up[0];
+ if(coords==A3D_LEFT_HANDED_CS){rx=-rx;ry=-ry;rz=-rz;}
+ float x=src[0]-lis[0],y=src[1]-lis[1],z=src[2]-lis[2];
+ float front=x*fwd[0]+y*fwd[1]+z*fwd[2];
+ float right=x*rx+y*ry+z*rz;
+ float high=x*up[0]+y*up[1]+z*up[2];
+ *az=aufake_v2_atan2(right,front)*AUFAKE_V2_RAD2DEG;
+ if(*az<0.0f)*az+=360.0f;
+ if(*az>=360.0f)*az-=360.0f;
+ *el=aufake_v2_atan2(high,a3d_sqrt(front*front+right*right))*AUFAKE_V2_RAD2DEG;
+ if(*el< -45.0f)*el= -45.0f;
+ if(*el> 90.0f)*el=90.0f;
+}
+/* Bilinear driver-like angle interpolation. 24 columns wrap at 360deg,
+ * a single top pole at 90deg, elevations below -45 clamp (not extrapolate).
+ * ITD is linearly interpolated in units of 1/512 output sample. */
+static void aufake_v2_lookup(float az,float el,float coeff[2][56],float itd[2]){
+ unsigned a=(unsigned)(az/15.0f);if(a>23u)a=23u;
+ unsigned b=(a+1u)%24u;
+ float wa=(az-15.0f*(float)a)/15.0f;
+ if(wa<0.0f)wa=0.0f;if(wa>1.0f)wa=1.0f;
+ unsigned e=(unsigned)((el+45.0f)/15.0f);if(e>8u)e=8u;
+ float we=(el+45.0f-15.0f*(float)e)/15.0f;
+ if(we<0.0f)we=0.0f;if(we>1.0f)we=1.0f;
+ unsigned n0=e*24u+a,n1=e*24u+b;
+ unsigned n2=e<8u?n0+24u:216u;
