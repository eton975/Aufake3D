diff --git a/Tools/inspect_descent3_executable.py b/Tools/inspect_descent3_executable.py
new file mode 100644
--- /dev/null
+++ b/Tools/inspect_descent3_executable.py
@@ -0,0 +1,57 @@
+#!/usr/bin/env python3
+"""Read-only PE import/marker inspection for an owner-provided Descent 3 EXE.
+
+This is evidence collection, not proof of executed A3D calls, compatibility,
+malware safety, or an instruction to patch the retail executable.
+"""
+from __future__ import annotations
+import argparse
+import hashlib
+import json
+import sys
+from pathlib import Path
+
+ROOT=Path(__file__).resolve().parents[1]
+sys.path.insert(0,str(ROOT/'Source/Engine/tools'))
+from security_audit_v072 import PEError,import_table  # noqa: E402
+
+TOKENS=("a3d.dll","a3dapi.dll","a3d2","aureal","sound_mixer_aureal",
+        "mssa3d2.m3d","directsound","dsound.dll","a3d_init", "co_createinstance")
+LIMIT=128*1024*1024
+
+def inspect(path:Path)->dict:
+    if not path.is_file():raise ValueError('expected an existing EXE file')
+    size=path.stat().st_size
+    if size>LIMIT:raise ValueError('input exceeds 128 MiB inspection limit')
+    data=path.read_bytes()
+    arch,imports=import_table(data)
+    # Preserve name matching in single-byte and UTF-16LE; these are only clues.
+    lo=data.lower()
+    markers=[t for t in TOKENS if t.encode() in lo or t.encode('utf-16le') in lo]
+    a3d_imports=[s for s in imports if s.partition('!')[0].lower() in ('a3d.dll','a3dapi.dll')]
+    relevant=[s for s in imports if s.partition('!')[2].lower() in
+              ('cocreateinstance','cogetclassobject','loadlibrarya','loadlibraryw',
+               'getprocaddress','directsoundcreate','directsoundcreate8')]
+    return {
+        'filename':path.name,'sha256':hashlib.sha256(data).hexdigest(),
+        'size':size,'architecture':arch,'aureal_static_imports':a3d_imports,
+        'possible_activation_imports':relevant,'static_text_markers':markers,
+        'a3d_path_confirmed':False,'gameplay_verified':False,
+        'interpretation':('Imports and strings are leads only. A game may resolve A3D '
+          'dynamically, use a utility wrapper, or never execute a referenced branch. '
+          'Only a runtime trace of original-game A3D calls confirms activation.'),
+    }
+
+def main()->int:
+    a=argparse.ArgumentParser(description=__doc__)
+    a.add_argument('exe',type=Path)
+    a.add_argument('--output',type=Path,help='write JSON locally (does not modify EXE)')
+    ns=a.parse_args()
+    try:result=inspect(ns.exe)
+    except (OSError,ValueError,PEError) as e:
+        a.exit(2,f'ERROR: {e}\n')
+    out=json.dumps(result,indent=2,sort_keys=True)+'\n'
+    if ns.output:ns.output.write_text(out,encoding='utf-8')
+    else:print(out,end='')
+    return 0
+if __name__=='__main__':raise SystemExit(main())
diff --git a/scripts/build_descent3_contract_probe.py b/scripts/build_descent3_contract_probe.py
new file mode 100644
--- /dev/null
+++ b/scripts/build_descent3_contract_probe.py
@@ -0,0 +1,90 @@
+#!/usr/bin/env python3
+"""Build the stand-alone, game-free Win32 Descent 3 A3D2 COM probe.
+
+Uses Clang/lld-link only. No retail files, game patches, registry writes,
+original Aureal binaries or GPL sources are included or modified. Creates
+exactly one console PE32 in dist/experimental-descent3. The A3D2 DLL itself is
+built by the existing main build system and deliberately left untouched.
+"""
+from __future__ import annotations
+
+import argparse
+import hashlib
+import os
+from pathlib import Path
+import shutil
+import struct
+import subprocess
+import tempfile
+
+ROOT = Path(__file__).resolve().parents[1]
+SRC = ROOT / "Source" / "Engine" / "win32"
+DEST = ROOT / "dist" / "experimental-descent3"
+NAME = "a3d-descent3-contract-probe.exe"
+IMPORTS = (
+    "LoadLibraryA@4", "GetProcAddress@8", "FreeLibrary@4",
+    "ExitProcess@4", "GetStdHandle@4", "WriteFile@20",
+    "Sleep@4", "GetCommandLineA@0",
+)
+
+
+def build(tempdir: Path, clang: str, linker: str) -> bytes:
+    def run(cmd: list[str]) -> None:
+        subprocess.run(cmd, cwd=SRC, check=True)
+
+    lib = tempdir / "kernel32-probe.lib"
+    run([
+        linker, "/dll", "/noentry", "/machine:x86",
+        "/def:" + str(SRC / "descent3_probe_kernel32.def"),
+        "/out:" + str(tempdir / "kernel32-stub.dll"),
+        "/implib:" + str(lib),
+    ])
+    obj = tempdir / "descent3-probe.obj"
+    run([
+        clang, "-target", "i686-pc-windows-msvc", "-ffreestanding",
+        "-fno-stack-protector", "-fno-builtin", "-O2", "-Wall",
+        "-Wextra", "-Werror", "-c", "descent3_contract_probe.c",
+        "-o", str(obj),
+    ])
+    exe = tempdir / NAME
+    run([
+        linker, "/subsystem:console", "/machine:x86", "/nodefaultlib",
+        "/entry:start@0", "/timestamp:0", "/out:" + str(exe),
+        str(obj), str(lib),
+        *[f"/alternatename:__imp__{name}=__imp__{name.split('@')[0]}"
+          for name in IMPORTS],
+    ])
+    data = exe.read_bytes()
+    if data[:2] != b"MZ" or len(data) < 256:
+        raise RuntimeError("not a PE executable")
+    off = struct.unpack_from("<I", data, 0x3C)[0]
+    if data[off:off+4] != b"PE\x00\x00" or struct.unpack_from("<H", data, off+4)[0] != 0x14c:
+        raise RuntimeError("not a Windows PE32/x86 executable")
+    return data
+
+
+def main() -> int:
+    ap = argparse.ArgumentParser(description=__doc__)
+    ap.add_argument("--clang", default=os.environ.get("CC", "clang"))
+    ap.add_argument("--linker", default=os.environ.get("LINK", "lld-link"))
+    ap.add_argument("--out", type=Path, default=DEST / NAME)
+    args = ap.parse_args()
+    for tool in (args.clang, args.linker):
+        if not shutil.which(tool) and not Path(tool).is_file():
+            ap.error(f"missing compiler/linker: {tool}")
+    with tempfile.TemporaryDirectory(prefix="aufake3d-descent3-a-") as aa, \
+         tempfile.TemporaryDirectory(prefix="aufake3d-descent3-b-") as bb:
+        a = build(Path(aa), args.clang, args.linker)
+        b = build(Path(bb), args.clang, args.linker)
+    if a != b:
+        raise RuntimeError("probe builds differ byte-for-byte")
+    args.out.parent.mkdir(parents=True, exist_ok=True)
+    args.out.write_bytes(a)
+    print("PASS: two independent PE32/i386 probe builds are identical")
+    print(f"{hashlib.sha256(a).hexdigest()}  {args.out}")
+    print("NOTE: this proves neither Wine runtime success nor Descent 3 gameplay compatibility")
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
