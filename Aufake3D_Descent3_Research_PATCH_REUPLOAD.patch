+  self.assertIn('if(!sr_pan_feature())return E_NOTIMPL',s)
+  self.assertIn('sr_setpan /* 57 SetPanValues */',s)
+  self.assertIn('sr_getpan /* 58 GetPanValues */',s)
+  self.assertIn('if(n!=1u && n!=2u)return E_INVALIDARG',s)
